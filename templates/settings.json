{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(uv:*)",
      "Bash(pixi:*)",
      "Bash(just:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(pyrefly:*)",
      "Bash(snakemake:*)",
      "Bash(marimo:*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./data/raw/**)",
      "Edit(./data/raw/**)",
      "Edit(./uv.lock)",
      "Edit(./pixi.lock)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 lab-conventions/templates/hooks/block_protected_writes.py"
          }
        ]
      }
    ]
  }
}
